{
  "name": "unit19-automated-testing",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "expo": "~57.0.27",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "private": true,
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3"
  },
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "App.js",
      "components/**/*.js",
      "utils/**/*.js",
      "!**/*.test.js"
    ]
  }
}
